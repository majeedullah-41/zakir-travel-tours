rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == "m7HIPZAuMRdO3IxAq4y6amGsdN53" ||
        isAllowlistedEmail()
      );
    }

    // True when the signed-in user's email is on the admin allowlist
    // (document admin_users/allowed, managed in the portal's Admin Access
    // tab). The exists() guard means a missing allowlist simply denies
    // instead of erroring, and the email is compared lowercased on both
    // sides (the portal always saves lowercased emails).
    function isAllowlistedEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/admin_users/allowed)
        && get(/databases/$(database)/documents/admin_users/allowed).data.get('emails', []) is list
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/admin_users/allowed).data.get('emails', []);
    }

    // Admin allowlist: who may open the admin portal besides the owner.
    // Never public. Only the owner (UID) or a custom-claim admin may
    // CHANGE the allowlist — an allowlisted admin must not be able to
    // mint new admins for themselves or anyone else. Any admin may read
    // it (the portal lists it), but writes are owner/claim-only.
    match /admin_users/{docId} {
      allow read: if isAdmin();
      allow write: if request.auth != null
        && (request.auth.token.admin == true || request.auth.uid == "m7HIPZAuMRdO3IxAq4y6amGsdN53");
    }

    // Public read access for real-time homepage listeners; writes restricted to admins
    match /site_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /special_deals/{dealId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /umrah_packages/{pkgId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /visa_services/{visaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /work_permits/{permitId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /work_permit_programmes/{programmeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lead capture: anyone may CREATE one enquiry (public forms), but only
    // admins may read, update or delete them, so leads are not public.
    // Creates are validated so the collection cannot be used as free storage.
    // NOTE: 'service' is a reserved word in Firestore Rules, so it must be
    // accessed as data['service'] — data.service fails to parse (lines 73-75).
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasAll(
          ['name', 'phone', 'service', 'source', 'status', 'createdAt']
        )
        // The client (js/firebase-db.js saveEnquiry) writes exactly
        // these 10 keys — nothing else may be smuggled into a lead.
        && request.resource.data.keys().hasOnly(
          ['name', 'phone', 'service', 'source', 'status', 'createdAt',
           'details', 'whatsappNumber', 'whatsappSent', 'id']
        )
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() >= 1
        && request.resource.data['service'].size() <= 120
        && request.resource.data.source is string
        && request.resource.data.source.size() >= 1
        && request.resource.data.source.size() <= 50
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() >= 10
        && request.resource.data.createdAt.size() <= 50
        && (!('details' in request.resource.data) || request.resource.data.details is string)
        && (!('details' in request.resource.data) || request.resource.data.details.size() <= 1000)
        && (!('whatsappNumber' in request.resource.data) || request.resource.data.whatsappNumber is string)
        && (!('whatsappNumber' in request.resource.data) || request.resource.data.whatsappNumber.size() <= 30)
        && (!('whatsappSent' in request.resource.data) || request.resource.data.whatsappSent is bool)
        && (!('id' in request.resource.data) || request.resource.data.id is string)
        && (!('id' in request.resource.data) || request.resource.data.id.size() <= 100);
      allow read, update, delete: if isAdmin();
    }
  }
}
