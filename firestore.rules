rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == "m7HIPZAuMRdO3IxAq4y6amGsdN53"
      );
    }

    // Public read access for real-time homepage listeners; writes restricted to admins
    match /site_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /special_deals/{dealId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /umrah_packages/{pkgId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /visa_services/{visaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /work_permits/{permitId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
