# Zakir Travel & Tours — environment settings (EXAMPLE — placeholders only)
#
# Copy this file to `.env` at the project root and fill in the REAL values:
#     cp .env.example .env
#
# NEVER commit `.env` to git and NEVER share it. `.env` is gitignored.
# This file contains NO real values — only placeholders and defaults.

# --- MySQL database (created in Hostinger hPanel -> Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# --- Admin sessions ---
# A long random string used to sign/protect session data. Generate one, e.g.:
#   openssl rand -hex 32
# and keep it secret — anyone with it could forge admin sessions.
SESSION_SECRET=change-me-to-a-long-random-string

# --- One-time owner account (used ONLY by `php db/seed_owner.php`) ---
# The email you will log in to the admin portal with, and its temporary
# password (at least 8 characters). Change the password after first login.
# After the owner is created, DELETE db/seed_owner.php from the server.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-at-least-8-chars

# --- App ---
# APP_ENV: production on the live site, development locally.
APP_ENV=production
# APP_URL: the public URL of the site, no trailing slash.
APP_URL=https://example.com
