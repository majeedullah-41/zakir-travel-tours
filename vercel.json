{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/umrah", "destination": "/umrah-packages.html" },
    { "source": "/umrah-packages", "destination": "/umrah-packages.html" },
    { "source": "/visas", "destination": "/visa-services.html" },
    { "source": "/visa-services", "destination": "/visa-services.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/contact-us", "destination": "/contact.html" },
    { "source": "/work-permit", "destination": "/work-permit.html" },
    { "source": "/home", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/calculator", "destination": "/umrah-packages#package-estimator", "permanent": false },
    { "source": "/estimator", "destination": "/umrah-packages#package-estimator", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

