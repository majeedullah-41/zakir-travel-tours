{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "destination": "/admin.html",
      "source": "/admin"
    },
    {
      "destination": "/umrah-packages.html",
      "source": "/umrah-packages"
    },
    {
      "destination": "/visa-services.html",
      "source": "/visa-services"
    },
    {
      "destination": "/contact.html",
      "source": "/contact"
    },
    {
      "destination": "/work-permit.html",
      "source": "/work-permit"
    }
  ],
  "redirects": [
    {
      "destination": "/umrah-packages",
      "permanent": true,
      "source": "/umrah"
    },
    {
      "destination": "/visa-services",
      "permanent": true,
      "source": "/visas"
    },
    {
      "destination": "/",
      "permanent": true,
      "source": "/home"
    },
    {
      "destination": "/contact",
      "permanent": true,
      "source": "/contact-us"
    },
    {
      "destination": "/umrah-packages#package-estimator",
      "permanent": false,
      "source": "/calculator"
    },
    {
      "destination": "/umrah-packages#package-estimator",
      "permanent": false,
      "source": "/estimator"
    }
  ],
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ],
      "source": "/(.*).html"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ],
      "source": "/js/(.*)"
    }
  ]
}
